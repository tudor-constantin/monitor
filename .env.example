APP_NAME=Monitor
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://monitor.example.com
APP_PORT=8000
REGISTRATION_ENABLED=false
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=monitor
DB_USERNAME=monitor
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_LIMITER_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-password

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=smtp-user
MAIL_PASSWORD=replace-with-your-smtp-password
MAIL_FROM_ADDRESS=monitor@example.com
MAIL_FROM_NAME=Monitor

HORIZON_ALLOWED_EMAILS=admin@example.com
HORIZON_PREFIX=monitor_horizon:
MONITOR_CHECK_RETENTION_DAYS=90
MONITOR_CREATION_LIMIT_PER_MINUTE=10
MONITOR_MAX_TIMEOUT_SECONDS=60
PUBLIC_SUBSCRIPTION_LIMIT_PER_HOUR=5
